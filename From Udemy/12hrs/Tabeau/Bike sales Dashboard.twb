      </column>
      <column caption='Choosen Year Profit' datatype='integer' name='[Calculation_1182851997282308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date - Year] = [Parameters].[Parameter 1] THEN [Profit] END' />
      </column>
      <column caption='Last year profit' datatype='integer' name='[Calculation_1182851997601797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date - Year] = DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]) THEN [Profit] END' />
      </column>
      <column caption='YoY % change' datatype='real' name='[Calculation_1182851997921286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1182851997282308]) - SUM([Calculation_1182851997601797]))/ SUM([Calculation_1182851997601797])' />
